<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FClash.WinUI</RootNamespace>
    <AssemblyName>FClash</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultAssets>false</EnableDefaultAssets>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>../../resources/branding/app.ico</ApplicationIcon>
    <Version>0.8.97</Version>
    <InformationalVersion>0.8.97</InformationalVersion>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <ProjectReference Include="../FClash.Domain/FClash.Domain.csproj" />
    <Content Include="../../resources/branding/app.ico" Link="Assets/app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Flags/*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Flags/LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/material-palettes.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/branding/icon.png" Link="Assets/icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/translations/*.json" Link="Translations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Translations/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishCompiledXaml" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(IntermediateOutputPath)App.xbf') Or !Exists('$(IntermediateOutputPath)MainWindow.xbf')" Text="Compiled XAML is missing; rebuild before publishing." />
    <ItemGroup>
      <_NativeCompiledXaml Include="$(IntermediateOutputPath)*.xbf" />
      <ResolvedFileToPublish Include="@(_NativeCompiledXaml)">
        <RelativePath>%(_NativeCompiledXaml.Filename)%(_NativeCompiledXaml.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
