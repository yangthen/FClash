<Window x:Class="FClash.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FClash">
 <Grid x:Name="Root">
  <Grid.Resources><ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="CanvasBrush" Color="#FFF8F7"/>
     <SolidColorBrush x:Key="RailBrush" Color="#F5ECEB"/>
     <SolidColorBrush x:Key="CardBrush" Color="#FFF0F0"/>
     <SolidColorBrush x:Key="CardStroke" Color="#EEDFE0"/>
     <SolidColorBrush x:Key="MutedBrush" Color="#514347"/>
     <SolidColorBrush x:Key="PrimaryBrush" Color="#805158"/>
     <SolidColorBrush x:Key="SelectionBrush" Color="#FFD9DC"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="CanvasBrush" Color="#191112"/>
     <SolidColorBrush x:Key="RailBrush" Color="#261D1E"/>
     <SolidColorBrush x:Key="CardBrush" Color="#21191A"/>
     <SolidColorBrush x:Key="CardStroke" Color="#3D2D30"/>
     <SolidColorBrush x:Key="MutedBrush" Color="#DAC0C2"/>
     <SolidColorBrush x:Key="PrimaryBrush" Color="#F2B7BE"/>
     <SolidColorBrush x:Key="SelectionBrush" Color="#633B41"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="8"/><Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   </Style>
   <Style TargetType="ListViewItem" x:Key="RailItemStyle">
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}"/></ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="{ThemeResource RailBrush}">
   <TextBlock Text="FClash" FontSize="12" Margin="16,0" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="1" Background="{ThemeResource RailBrush}">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <Border Width="50" Height="50" CornerRadius="14" Background="{ThemeResource CardStroke}" VerticalAlignment="Top" Margin="0,10,0,0">
    <Image Source="ms-appx:///Assets/icon.png" Width="34" Height="34"/>
   </Border>
   <ListView x:Name="Navigation" Grid.Row="1" SelectionChanged="Navigate" ItemContainerStyle="{StaticResource RailItemStyle}"
    SelectionMode="Single" HorizontalContentAlignment="Stretch" IsTabStop="False"/>
   <Button x:Name="RailLabelsButton" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}" Click="ToggleRailLabels" ToolTipService.ToolTip="显示导航标签">
    <FontIcon FontFamily="ms-appx:///Assets/Fonts/materialicons-regular.otf#Material Icons" Glyph="&#xE3DC;" FontSize="24"/>
   </Button>
  </Grid>
  <Grid Grid.Column="1" Grid.Row="1" Background="{ThemeResource CanvasBrush}">
   <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Padding="8,0,16,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Click="GoBackClick" ToolTipService.ToolTip="返回">
     <FontIcon FontFamily="ms-appx:///Assets/Fonts/materialicons-regular.otf#Material Icons" Glyph="&#xE092;" FontSize="24"/>
    </Button>
    <TextBlock x:Name="PageTitle" Grid.Column="1" Text="仪表盘" FontSize="22" Margin="8,0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
     <TextBlock x:Name="RunStatus" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" Margin="8,0"/>
     <StackPanel x:Name="PageActions" Orientation="Horizontal" Spacing="4"/>
    </StackPanel>
   </Grid>
   <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="16,0,16,8"/>
   <ScrollViewer x:Name="Scroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Body" Padding="16,16,16,88" Spacing="14"/>
   </ScrollViewer>
   <Button x:Name="PowerButton" Grid.Row="2" Width="56" Height="56" CornerRadius="16" Padding="16" Margin="16"
    Background="{ThemeResource SelectionBrush}" Foreground="{ThemeResource MutedBrush}" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="TogglePower" ToolTipService.ToolTip="启动">
    <FontIcon FontFamily="ms-appx:///Assets/Fonts/materialicons-regular.otf#Material Icons" Glyph="&#xE4CB;" FontSize="24"/>
   </Button>
  </Grid>
 </Grid>
</Window>
